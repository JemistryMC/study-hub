-  -- Return lightweight status, revision, and updated_at (NOT the multi-megabyte payload)
-  RETURN jsonb_build_object(
-    'status', 'success',
-    'revision', v_current_rev,
-    'updated_at', v_updated_at
-  );
-END;
-$$;
