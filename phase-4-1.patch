+function extractFunctionSource(code, funcName) {
+  const patterns = [`async function ${funcName}(`, `function ${funcName}(`];
+  let startIdx = -1;
+  for (const pat of patterns) {
+    startIdx = code.indexOf(pat);
+    if (startIdx !== -1) break;
