+  if (startIdx === -1) throw new Error(`Function ${funcName} not found in index.html`);
+  let depth = 0;
+  let inFunc = false;
+  let endIdx = startIdx;
+  for (let i = startIdx; i < code.length; i++) {
+    if (code[i] === '{') {
+      depth++;
+      inFunc = true;
+    } else if (code[i] === '}') {
+      depth--;
+      if (inFunc && depth === 0) {
+        endIdx = i + 1;
+        break;
+      }
+    }
   }
+  return code.substring(startIdx, endIdx);
